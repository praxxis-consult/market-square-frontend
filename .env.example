# Upstream gateway. Leave unset to run in fixture mode: the BFF serves
# realistic sample data from lib/fixtures and the whole app demos standalone.
# WSAPI_BASE_URL=https://gateway.example.com

# Decane auth. Leave the app id unset for fixture/demo mode (a demo session is
# assumed). Set it to enable real sign-in and server-side token verification.
# DECANE_API_KEY is SERVER-ONLY: the browser fetches it from /api/decane/key at
# runtime, and its allowed_origins in Decane must name both of Square's hosts.
# Never set a NEXT_PUBLIC_ copy of it. DECANE_VERIFICATION_KEY (an ES256 SPKI
# PEM) is optional: set, tokens verify offline instead of via Decane's JWKS.
# NEXT_PUBLIC_DECANE_APP_ID=
# DECANE_API_KEY=
# DECANE_VERIFICATION_KEY=

# Privy — LEGACY under Decane, PRIMARY on staging. The app id powers the "Bring
# your old account" page (/move-account); the secret lets the BFF keep
# accepting pre-migration Privy sessions until they age out, and verify the old
# token on an account link. Remove both when the link window closes — unless
# NEXT_PUBLIC_AUTH_PROVIDER=privy
#
# Whether the Privy sign-in card draws the Ark (Google) button. Google is a
# per-APP Privy setting and the two apps need not agree — the staging app had
# it off until 2026-11-08, and a button that opens a disabled provider fails
# every time it is pressed. Defaults ON under the Privy leg; set to 0 to drop
# it rather than editing the sign-in card.
# NEXT_PUBLIC_PRIVY_GOOGLE=0, where this pair IS the product's session.
# NEXT_PUBLIC_PRIVY_APP_ID=
# PRIVY_APP_SECRET=

# Which vendor signs people in: unset (Decane, production) or "privy".
#
# The STAGING backend runs AUTH_PROVIDERS=privy because Decane's production
# subscription is unpaid, so staging was stood up on Privy instead. A Decane
# token sent there is refused as UNAUTHORIZED — byte-identical to sending no
# token at all — so the whole API reads as dead rather than as a mismatch.
# Hence a switch rather than a branch: the staging build differs from
# production by this one value, and the auth code cannot drift between them.
#
# Setting it to "privy" needs NEXT_PUBLIC_PRIVY_APP_ID *and* PRIVY_APP_SECRET
# from the SAME Privy app — the BFF verifies the token itself before forwarding
# (lib/server/privy.ts), so a mismatched pair fails at our own proxy with a 401
# that looks exactly like being signed out. With no app id it falls back to
# demo mode rather than drawing a sign-in card that cannot work.
# NEXT_PUBLIC_AUTH_PROVIDER=privy
#
# Whether the Privy sign-in card draws the Ark (Google) button. Google is a
# per-APP Privy setting and the two apps need not agree — the staging app had
# it off until 2026-11-08, and a button that opens a disabled provider fails
# every time it is pressed. Defaults ON under the Privy leg; set to 0 to drop
# it rather than editing the sign-in card.
# NEXT_PUBLIC_PRIVY_GOOGLE=0

# Account linking. The service is mounted at /v1/user-management on the
# gateway, NOT /v1/migration — the env var is named for our side of it, and
# anyone debugging a 404 on the wrong mount loses an afternoon. OFF unless "1".
# Only turn it
# on where WSAPI_BASE_URL's gateway actually has a `migration` entry (staging
# does, production does not yet) — never point one environment's identities at
# another's service. MIGRATION_API_URL overrides the base for a local service.
# MIGRATION_SERVICE_ENABLED=1
# MIGRATION_API_URL=http://localhost:3000/v1/user-management

# Destination for the WorldStreet slide's "Join now" in the Ecosystem
# Partners rail (overrides the built-in default). There is no longer a
# WorldStreet nav entry — that rail is the only door to the platform left.
NEXT_PUBLIC_WORLDSTREET_URL=https://worldstreetgold.com

# The KASH engine. Unset, it derives from WSAPI_BASE_URL as
# ${WSAPI_BASE_URL}/v1/kash. Set it to point one service at a different
# environment while the rest of the app stays on the gateway. With neither set,
# the KASH balance and the Get KASH sheet go quiet rather than erroring.
# KASH_API_URL=https://api.tsionark.com/v1/kash

# Server-only. The routing provider's key for $TICKER buys. Unset, the ticker
# sheet still opens and shows the coin and its price; it just says buying is
# not available here. DEXTOPUS_API_KEY is honoured as a fallback.
# DEXTOPUS_TRADE_API_KEY=
# DEXTOPUS_API_KEY=

# Gas sponsorship, behind our own session-gated proxy. This is what makes a
# purchase possible at all: an embedded wallet funded with USDC alone has no
# ETH to pay Base gas with, so without these every send fails.
#
# ALCHEMY_API_KEY IS A COMMA-SEPARATED LIST, walked in order. One key was a
# single point of failure: when that Alchemy app hit its rate limit, every
# sponsored send failed at once and nobody could buy coins. Reads survive a
# throttled key because they fall back; sponsorship cannot, because nothing
# else pays our gas.
#
# ALCHEMY_GAS_POLICY_ID is INDEX-ALIGNED with it. A Gas Manager policy belongs
# to the Alchemy app that created it, so the key at index N is only ever sent
# with the policy at index N — a mismatched pair is answered "Policy not
# found". Leave a slot blank (",,") for a key with no policy; it then reads but
# never sponsors. A key that answers capacity, a rate limit or an auth error is
# skipped for a cooldown rather than asked again.
#
#   ALCHEMY_API_KEY=k0,k1,k2
#   ALCHEMY_GAS_POLICY_ID=p0,,p2      <- k1 reads, never sponsors
#
# See wsws ADR-2026-09-07-alchemy-key-pool, which this is ported from.
# ALCHEMY_API_KEY=
# ALCHEMY_GAS_POLICY_ID=
# Deprecated: appended after the list above. Move the key into the list.
# ALCHEMY_API_KEY_FALLBACK=

# EVM reads go to ZeroDev FIRST and only fall through to the Alchemy pool.
# Reads are the bulk of our RPC traffic — every balance, the eth_getCode and
# nonce on the sponsored send path, and every receipt poll — and putting them
# on the same key that sponsors is what let read volume break purchases. With
# this set, a throttled Alchemy key no longer takes the app's reads with it.
# One project serves every supported chain. Server-only; never NEXT_PUBLIC_*.
# ZERODEV_PROJECT_ID=

# Live gift tray: prices, KASH totals and the coin chrome. OFF shows the free
# tray — the shared on-stream moment with no money leg and no payment language.
# Turn ON only once profiles carry a wallet, or every gift fails with
# "This author has no wallet to receive tips" AFTER the burst has played.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
NEXT_PUBLIC_MS_LIVE_GIFTS_ENABLED=false

# Houses: audio-only rooms where anyone can open a table and raise a hand.
# This gates the NAV ENTRY, and only that. It does NOT gate creation: Home's
# hallway and the live CTA both open a gist room with no flag check, so rooms
# are not dark while this is off. The shipped label is "Open a gist room".
# /gist-rooms/[id] always resolves, because a link somebody was sent has to
# work. (/houses/[id] is a DIFFERENT route — the houses directory detail.)
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
NEXT_PUBLIC_MS_HOUSES_ENABLED=false

# The desktop sidebar. Off by default: BottomDock replaced it on every size, so
# the dock is the app's only navigation. `true` brings the sidebar back on
# desktop and steps the dock back to phones, so the two never both claim it.
# A LAYOUT SWITCH, not a capability — nothing is greyed out either way.
# NEXT_PUBLIC_* is inlined at BUILD time: set it, then REBUILD, not just restart.
NEXT_PUBLIC_MS_SIDEBAR_ENABLED=false

# ws-gateway: a realtime "the lane's head changed" signal for the home feed,
# layered on the 30-second head check, which stays as the floor. ABSENT means
# no socket is ever opened — the poll runs alone. Set to the gateway origin.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
# NEXT_PUBLIC_MS_WS_GATEWAY_URL=wss://ws.example.com/

# Server-only. Link previews — the Open Graph card a shared post or profile
# unfurls into on WhatsApp, X, Telegram and the rest. Unset means ON. Set to
# `off` to make every post and profile publish the generic Square card with no
# request to the service: the one-deploy stop if a preview ever shows something
# it should not. Crawlers cache previews for days, so turning this off stops
# NEW cards; it cannot recall ones already cached.
# SHARE_PREVIEWS=off

# Mixpanel, the analytics transport that exists today.
#
# The PROJECT token, which is write-only and designed to sit in client code —
# it cannot read a project. Unset means analytics is a no-op, which is the
# correct state for a local checkout and for any environment that should not
# report. Never put the API SECRET here: it is a different credential and
# nothing in this app reads one.
NEXT_PUBLIC_MIXPANEL_TOKEN=
#
# Optional. A first-party path on our own origin to proxy ingest through.
# Unset, the browser calls api.mixpanel.com directly and most ad-blockers stop
# it — an uneven undercount, since the people who block are not a random
# sample. Set this once a proxy route exists and nothing else changes.
NEXT_PUBLIC_MIXPANEL_PROXY=

# ─── ONE APP, TWO ADDRESSES ──────────────────────────────────────────────────
# The build-time switch that decides WHICH Square this is, and the only
# variable that can change every address in the app. UNSET = the standalone
# site at square.tsionark.com, no prefix. `/square` = the build Ark mounts as a
# Next.js zone at www.tsionark.com/square. Any other value FAILS the build
# (parseBase), deliberately: a typo here would silently serve a site whose
# every link is wrong. Routes never move under app/square — the zone build
# rewrites instead, so one set of routes serves both.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
# NEXT_PUBLIC_SQUARE_BASE_PATH=/square

# Server-only, and ONLY for the zone build. Canonical origin in page metadata,
# so a post shared out of the Ark-mounted copy unfurls to an address that
# resolves. Unset, metadata uses the request's own origin.
# SQUARE_CANONICAL_ORIGIN=https://www.tsionark.com

# ─── SIBLING PRODUCTS ────────────────────────────────────────────────────────
# The deployed Ark app. Drives cross-product deep links and the $TICKER
# catalogue together (/api/symbols fetches it from here), so unconfigured means
# no catalogue, no price, and a $TICKER stays plain text instead of opening a
# buy sheet. Defaults to https://www.tsionark.com — verified, not assumed: it
# is NOT worldstreetgold.com (the marketing site) and NOT
# dashboard.worldstreetgold.com (a different app).
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
# NEXT_PUBLIC_ARK_APP_URL=https://www.tsionark.com

# ArkPlay, which serves the avatar characters and the game catalogue. Defaults
# to https://game-server.tsionark.com. Only the URL is public — ArkPlay's
# `apk_` API key is server-side and must NEVER get a NEXT_PUBLIC_ copy.
# Inlined at BUILD time (NEXT_PUBLIC_): needs a rebuild, not a restart.
# NEXT_PUBLIC_ARKPLAY_URL=https://game-server.tsionark.com

# ─── THE REMAINING CAPABILITY FLAGS ──────────────────────────────────────────
# Each compares against the exact string "true". `1`, `yes` and `TRUE` are all
# off. Every one is inlined at BUILD time: set it, then REBUILD.
# See README.md#capability-flags for what each is waiting on, and
# docs/GOVERNANCE.md for which need whose approval.

# Replays of ended streams. The recording code is FULLY IMPLEMENTED on the
# service; `replayUrl` is null until THREE independent switches line up —
# LiveKit egress actually running (infrastructure, and it is Ark Stream's
# deployment, not ours), LIVEKIT_S3_* set on the service, and this flag.
# Turning on one of the three makes both halves look correct while nothing
# appears. Confirm a real ended stream returns a non-null replayUrl FIRST: the
# flag makes the surfaces reappear, it cannot make the recordings exist.
NEXT_PUBLIC_MS_REPLAYS_ENABLED=false

# VIP ticket tiers. Off until entitlement timing, refund and replay rules are
# approved in writing — it takes money, so the copy cannot promise it sooner.
NEXT_PUBLIC_MS_VIP_ACCESS_ENABLED=false

# Promotion of the ARK Store in navigation. PROMOTION ONLY: /store and
# /store/[slug] keep working either way, deep links resolve, and Explore's
# Products tab still lists items. Hiding an entry must never break a route.
NEXT_PUBLIC_MS_STORE_NAV_ENABLED=false

# ─── POLYGON GAS SPONSORSHIP ─────────────────────────────────────────────────
# Index-aligned with ALCHEMY_API_KEY exactly as ALCHEMY_GAS_POLICY_ID is, but
# for Polygon: a Gas Manager policy belongs to one chain as well as one app, so
# a Base policy sent on a Polygon userOperation is answered "Policy not found".
# Unset, Polygon reads work and nothing is sponsored there.
# ALCHEMY_POLYGON_GAS_POLICY_ID=

# ─── NOT AN APP VARIABLE ─────────────────────────────────────────────────────
# Read only by scripts/check-public-routes.mjs, to point the check at another
# environment's openapi.json. Never read at runtime.
#   MS_API_BASE=https://api.tsionark.com pnpm check:public-routes

# Read only by scripts/verify-privy-token.mjs, the diagnostic that checks a
# Privy access token against the app's public JWKS the way the BFF does —
# written when production 401'd every authenticated call while the browser held
# a good session, and nothing could say which half was wrong. No secret is
# involved; the check is a public-key one.
#   PRIVY_TOKEN=<token> PRIVY_APP_ID=<app id> node scripts/verify-privy-token.mjs
# PRIVY_TOKEN=
# PRIVY_APP_ID=
